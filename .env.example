# ---- Bot de Telegram ----
# Se obtiene hablando con @BotFather en Telegram
TELEGRAM_BOT_TOKEN=

# ---- Base de datos (Azure Database for MySQL Flexible Server) ----
# DB_HOST: el "Nombre del servidor" que copiaste del portal, ej:
#   chatbot-iti-mysql.mysql.database.azure.com
# DB_USER: el usuario administrador que definiste al crear el servidor
#   (en Azure MySQL Flexible Server ya NO se usa el formato usuario@servidor,
#   basta con el nombre de usuario simple)
# DB_SSL: Azure exige conexión cifrada, debe quedar en "true"
DB_HOST=localhost
DB_PORT=3306
DB_NAME=chatbot_iti
DB_USER=root
DB_PASSWORD=
DB_SSL=false

# ---- Servidor Express ----
PORT=3000
NODE_ENV=development

# IDs numéricos de Telegram del personal de Contabilidad (separados por coma).
# Cada persona puede obtener su ID escribiéndole a @userinfobot en Telegram.

# ---- Azure (se completa en fases posteriores) ----
AZURE_STORAGE_CONNECTION_STRING=
APPINSIGHTS_CONNECTION_STRING=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@iti.edu.ec

# Zona horaria institucional para fechas de negocio
APP_TIMEZONE=America/Guayaquil

# ---- Esquema y runtime productivo ----
# En producción usar migrate. sync-alter queda bloqueado en NODE_ENV=production.
DB_SCHEMA_MODE=migrate
DB_CONNECT_TIMEOUT_MS=15000
BOT_SESSION_TTL_HOURS=72
TELEGRAM_UPDATE_LEASE_SECONDS=300
TELEGRAM_UPDATE_RETENTION_DAYS=30
HTTP_JSON_LIMIT=1mb
SHUTDOWN_TIMEOUT_MS=15000

# API operativa protegida
OPS_API_KEY=

# ---- IA documental + NLP ----
# Document Intelligence puede funcionar sin Azure OpenAI.
AI_DOCUMENT_INTELLIGENCE_ENABLED=false
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
AZURE_DOCUMENT_INTELLIGENCE_API_VERSION=2024-11-30
AZURE_DOCUMENT_INTELLIGENCE_MODEL=prebuilt-invoice
AI_AUTO_ANALYZE_DOCUMENTS=false
AI_MIN_CONFIDENCE=0.72
AI_MAX_FILE_BYTES=4194304
AI_MAX_OCR_CHARS=12000
AI_DOWNLOAD_TIMEOUT_MS=20000
AI_DOCUMENT_REQUEST_TIMEOUT_MS=30000
AI_DOCUMENT_POLL_TIMEOUT_MS=90000
AI_DOCUMENT_POLL_INTERVAL_MS=1200

# NLP semántico opcional con Azure OpenAI/Foundry.
# Si está deshabilitado, el bot conserva un reconocedor local de intents.
AI_NLP_ENABLED=false
AI_NLP_MIN_CONFIDENCE=0.60
AI_AZURE_OPENAI_ENABLED=false
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_MODEL=
AI_OPENAI_REQUEST_TIMEOUT_MS=45000

# ---- Dashboard web interno ----
# Acceso: https://dominio-app.azurewebsites.net/dashboard
DASHBOARD_ENABLED=false
# Generar un secreto largo y aleatorio. No guardarlo en Git.
DASHBOARD_SESSION_SECRET=
DASHBOARD_SESSION_HOURS=8
DASHBOARD_ALLOWED_ROLES=contadora,asistente_contable,coordinador_general,director_general,colecturia,cash_management,coordinador_carrera
